# Salin file ini menjadi .env lalu isi nilainya.
# Semua nilai bisa diambil dari Supabase Dashboard > Project Settings.

# --- Dipakai di sisi browser (wajib prefix VITE_) ---
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.isi-anon-key-disini

# URL publik aplikasi (dipakai untuk membuat link undangan & preview WA)
#   auto   = ikut alamat yang sedang dibuka (localhost / IP LAN / domain sendiri)
#   <url>  = paksa ke URL tertentu, mis. https://invite.irkop.eu.org
VITE_APP_URL=auto

# --- Dipakai Cloudflare Pages Functions (tanpa prefix VITE_) ---
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.isi-anon-key-disini
APP_URL=auto

# --- Hanya untuk tooling lokal, tidak pernah dikirim ke browser ---
# Database password (Dashboard > Project Settings > Database). Dipakai `npm run db:push`.
SUPABASE_DB_PASSWORD=

# Opsional: override host koneksi kalau direct connection gagal (IPv6-only).
# Contoh Session pooler: aws-0-ap-southeast-1.pooler.supabase.com
# SUPABASE_DB_HOST=
